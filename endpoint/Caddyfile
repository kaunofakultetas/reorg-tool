:80 {
    route {

        # BACKEND API
        handle /api/* {
            reverse_proxy reorg-backend:8000 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            }
        }


        # VITE GUI
        handle /* {
            reverse_proxy reorg-vite:80 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            }
        }

    }
}
